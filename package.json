{
  "name": "notediscovery-frontend",
  "private": true,
  "scripts": {
    "build:live-preview": "esbuild frontend/src/live-preview.js --bundle --format=esm --platform=browser --target=es2020 --outfile=frontend/dist/live-preview.js",
    "build:live-preview:minify": "npm run build:live-preview -- --minify",
    "test": "node --test tests/frontend/*.test.mjs",
    "check:frontend": "npm test && npm run build:live-preview:minify"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "html-minifier-terser": "7.2.0"
  }
}
