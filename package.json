{
  "name": "notediscovery-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build:live-preview": "esbuild frontend/src/live-preview.js --bundle --format=esm --platform=browser --target=es2020 --outfile=frontend/dist/live-preview.js",
    "build:live-preview:minify": "npm run build:live-preview -- --minify",
    "build:vendor": "esbuild frontend/src/vendor.js frontend/src/mermaid-vendor.js frontend/src/vis-network-vendor.js --bundle --format=esm --platform=browser --target=es2020 --outdir=frontend/dist --entry-names=[name]",
    "build:styles": "tailwindcss -c tailwind.config.cjs -i frontend/src/tailwind.css -o frontend/dist/tailwind.css --minify",
    "build:static-assets": "node scripts/copy-frontend-assets.mjs",
    "build:frontend": "npm run build:styles && npm run build:vendor && npm run build:static-assets && npm run build:live-preview",
    "build:frontend:minify": "npm run build:styles && npm run build:vendor -- --minify && npm run build:static-assets && npm run build:live-preview:minify",
    "test": "node --test tests/frontend/*.test.mjs",
    "check:frontend": "npm test && npm run build:frontend:minify"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2",
    "alpinejs": "3.15.12",
    "dompurify": "3.4.12",
    "highlight.js": "11.11.1",
    "marked": "12.0.2",
    "mathjax": "3.2.2",
    "mermaid": "11.16.0",
    "qrcode-generator": "1.4.4",
    "vis-network": "9.1.13"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "html-minifier-terser": "7.2.0",
    "tailwindcss": "3.4.17"
  }
}
